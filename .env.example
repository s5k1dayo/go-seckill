# =========================================================
# 秒杀系统环境变量示例
# 用法：cp .env.example .env  （.env 已被 .gitignore 忽略）
# =========================================================

# ---------- 必填：JWT 签名密钥 ----------
# 生成方式：openssl rand -hex 32
JWT_SECRET_KEY=please-change-me-to-a-random-32-bytes-string

# ---------- MySQL ----------
# Docker 部署时由 compose 使用；请改成强密码
MYSQL_ROOT_PASSWORD=root123
MYSQL_PASSWORD=seckill123

# ---------- RabbitMQ ----------
RABBITMQ_USER=admin
RABBITMQ_PASSWORD=admin123

# ---------- 令牌桶限流 ----------
LIMIT_R=300
LIMIT_BURST=500

# ---------- 本地直接运行（非 Docker）时使用 ----------
# Docker 部署时，compose 会用容器服务名覆盖 DSN / MQ / REDIS_ADDR，无需修改这里。
# 注意：DSN 里的密码要与 MYSQL_PASSWORD 保持一致；MQ 里的账号要与 RABBITMQ_* 保持一致。
DSN=seckill:seckill123@tcp(127.0.0.1:3306)/seckill?parseTime=true&charset=utf8mb4&loc=Local
MQ=amqp://admin:admin123@localhost:5672/
REDIS_ADDR=127.0.0.1:6379
